# PulsePass — variables de entorno (Fase 4: capa de seguridad)
# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio (.env está en .gitignore).

# --- JWT (OBLIGATORIO) ---
# Secreto Base64 de AL MENOS 32 bytes para firmar y verificar los tokens HS256.
# La aplicación NO arranca si esta variable falta o si decodifica a menos de 32 bytes (deny-by-default).
# Genera uno nuevo, por ejemplo:
#   python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
#   openssl rand -base64 32
PULSEPASS_JWT_SECRET_BASE64=REEMPLAZA-CON-SECRETO-BASE64-DE-32-BYTES-O-MAS

# --- Opcionales (tienen default en application.properties) ---
# Issuer (claim "iss") exigido en la validación del token. Default: pulsepass-api
# pulsepass.security.jwt.issuer=pulsepass-api
# TTL ISO-8601 del access token. Default: PT15M (900 segundos)
# pulsepass.security.jwt.access-token-ttl=PT15M
# Orígenes CORS permitidos (lista separada por comas). Default: vacío = ningún origen cross-origin
# PULSEPASS_CORS_ALLOWED_ORIGINS=https://app.ejemplo.com

# --- Base de datos (solo si no se usa el DataSource local por defecto) ---
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/pulsepass
# SPRING_DATASOURCE_USERNAME=pulsepass
# SPRING_DATASOURCE_PASSWORD=cambia-esto

# Nota de pruebas: la suite (./mvnw clean test) NO requiere estas variables; usa un secreto
# exclusivo de pruebas inyectado por @TestPropertySource y PostgreSQL vía Testcontainers.
